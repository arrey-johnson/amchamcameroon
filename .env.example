# ── Database ───────────────────────────────────────────────────────────────
# Supabase session pooler (port 5432). SSL is handled in payload.config.ts.
DATABASE_URI=postgresql://amcham_app.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Payload ──────────────────────────────────────────────────────────────────
# Long random string used to sign admin sessions. REQUIRED in production.
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# ── Public site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suppress libvips/Sharp GLib console noise (optional; also set by npm run dev)
VIPS_WARNING=0

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ── Transactional email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=

# ── Optional S3 keys (only if you are not using SUPABASE_SERVICE_ROLE_KEY) ──
S3_BUCKET=
S3_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
