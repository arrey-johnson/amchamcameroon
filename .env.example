# ── Database ───────────────────────────────────────────────────────────────
# Local dev (default): SQLite, zero-setup.
DATABASE_URI=file:./amcham.db
#
# Production (Supabase): paste the Supabase "Session pooler" connection string.
# The app auto-switches to Postgres when DATABASE_URI starts with "postgres".
# Example:
# DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ── Payload ──────────────────────────────────────────────────────────────────
# Long random string used to sign admin sessions. REQUIRED in production.
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# ── Public site ──────────────────────────────────────────────────────────────
# Your deployed URL (used in emails, SEO metadata and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Enables the auto-reply + admin notification. Leave empty to disable sending.
RESEND_API_KEY=

# ── Media storage (Supabase Storage, S3-compatible) ──────────────────────────
# REQUIRED in production on Vercel (its disk is read-only/ephemeral).
# Get these from Supabase → Project Settings → Storage → S3 Connection.
# Leave S3_BUCKET empty in local dev to store uploads on the local disk.
S3_BUCKET=
S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
